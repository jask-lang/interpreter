<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JaskInterpreter</RootNamespace>
    <PublishAot>true</PublishAot>
    <AssemblyName>jask</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../jcore/*.jask" />
  </ItemGroup>

</Project>
